rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- Trip Validation ---
    function isValidTrip(data) {
      return data.keys().hasAll(['userId', 'title', 'destination']) 
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.destination is string && data.destination.size() <= 200
        && (!('state' in data) || (data.state is string && data.state.size() <= 100))
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('status' in data) || (data.status in ['visited', 'planned', 'ongoing', 'completed']))
        && (!('isFavorite' in data) || (data.isFavorite is bool))
        && (!('rating' in data) || data.rating is number)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 50))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 2000))
        && (!('imageCredit' in data) || (data.imageCredit is string && data.imageCredit.size() <= 200))
        && (!('gallery' in data) || (data.gallery is list && data.gallery.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('budget' in data) || data.budget is number)
        && (!('coordinates' in data) || (data.coordinates is map))
        && (!('itinerary' in data) || (data.itinerary is list && data.itinerary.size() <= 100))
        && (!('participants' in data) || (data.participants is list && data.participants.size() <= 50))
        && (!('checkInsCount' in data) || data.checkInsCount is number)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // --- Checkin Validation ---
    function isValidCheckin(data) {
      return data.keys().hasAll(['userId', 'placeName', 'lat', 'lng', 'timestamp'])
        && data.userId == request.auth.uid
        && (!('tripId' in data) || (data.tripId is string && data.tripId.size() <= 128))
        && data.placeName is string && data.placeName.size() <= 200
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && data.lat is number
        && data.lng is number
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && data.timestamp is string && data.timestamp.size() <= 50
        && (!('googleMapsUrl' in data) || (data.googleMapsUrl is string && data.googleMapsUrl.size() <= 2000));
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(tripId) && isValidTrip(incoming());
      allow update: if isSignedIn() && isValidId(tripId) && existing().userId == request.auth.uid && isValidTrip(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(tripId) && existing().userId == request.auth.uid;
    }

    // Checkins Collection
    match /checkins/{checkinId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(checkinId) && isValidCheckin(incoming());
      allow update: if isSignedIn() && isValidId(checkinId) && existing().userId == request.auth.uid && isValidCheckin(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(checkinId) && existing().userId == request.auth.uid;
    }

    // User Settings Collection
    match /usersettings/{settingId} {
      allow read, get: if isSignedIn() && (settingId == request.auth.uid || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update, write: if isSignedIn() && settingId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && settingId == request.auth.uid;
    }
  }
}
